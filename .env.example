# Plantilla sin secretos reales. Copiar a .env.local y completar.
# La configuración se valida al arrancar (src/config/env.ts): un valor inválido detiene la aplicación.
# Regla: NINGÚN secreto lleva el prefijo NEXT_PUBLIC_ (se expone al navegador). Ver docs/security.md.

# --- Entorno -------------------------------------------------------------
# development | staging | production. Fuera de "production" todo el sitio es noindex (docs/i18n.md §6).
SITE_ENV=development

# --- Sitio (público) -----------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Teselas (público) ---------------------------------------------------
# Base de los PMTiles servidos por Range (relativa a este origen o URL absoluta). Ver docs/gis.md.
NEXT_PUBLIC_TILES_BASE_URL=/data

# Relieve (Terrarium). Se carga SOLO si la persona activa una capa de relieve; es un tercero (AWS) que ve su IP.
# Plantilla con {z}/{x}/{y}; si es absoluta, su origen se añade a connect-src. Por defecto AWS Terrain Tiles.
# NEXT_PUBLIC_TERRAIN_TILES_URL=https://elevation-tiles-prod.s3.amazonaws.com/terrarium/{z}/{x}/{y}.png

# --- Base de datos (servidor) -------------------------------------------
# PostgreSQL con PostGIS. No requerido para la Foundation visual; sí para db:migrate y test:integration.
# DATABASE_URL=postgres://usuario:clave@localhost:5432/panama_immersive
# DATABASE_URL_TEST=postgres://usuario:clave@localhost:5432/panama_immersive_test

# --- Integraciones opcionales (BLOQUEADAS hasta tener credencial; ver docs/setup.md) ----
# Cada integración se activa SOLO si su flag es true Y existe su credencial; si no, queda
# deshabilitada con un motivo observable. Ninguna está creada ni contratada.
FEATURE_GOOGLE_3D=false
# GOOGLE_MAPS_API_KEY=            # servidor; restringir por API y origen; cuota y presupuesto
FEATURE_CESIUM=false
# CESIUM_ION_TOKEN=
FEATURE_MAPILLARY=false
# MAPILLARY_ACCESS_TOKEN=
